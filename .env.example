# ── HTTP ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3300

# ── Auth ──────────────────────────────────────────────────────────────────────
# Per-site keys, `site:secret` comma separated. The same secret is both the HMAC
# key for the signed GET and the Bearer token for POST. Generate with
# `openssl rand -base64 32`. Real secrets never enter git.
OG_SITE_KEYS=patch:CHANGE_ME,letmoe:CHANGE_ME,forum:CHANGE_ME,infra:CHANGE_ME

# Wordmark drawn on the card. Not a domain — the domain is still undecided.
# Exact casing per CLAUDE.md iron rule: NextMoe·未萌.
OG_BRAND=NextMoe·未萌

# ── Fonts ─────────────────────────────────────────────────────────────────────
# 28 MiB of Noto, fetched by `pnpm fonts`. Missing files fail renderer startup.
FONT_DIR=assets/fonts

# ── Cache ─────────────────────────────────────────────────────────────────────
# Disk holds the image bytes. Redis is OPTIONAL: leave REDIS_URL empty and the
# service runs on the disk layer alone (no LRU accounting, TTL falls back to mtime).
CACHE_DIR=cache
CACHE_TTL_DAYS=30
CACHE_MAX_MB=2048
REDIS_URL=

# ── Render ────────────────────────────────────────────────────────────────────
# RENDER_QUEUE_MAX is a hard cap, not a buffer: past it requests get 429 instead
# of queueing until the caller times out. 0 disables the cap.
RENDER_CONCURRENCY=4
RENDER_QUEUE_MAX=32
RENDER_TIMEOUT_MS=10000
RENDER_FORMAT=webp
RENDER_QUALITY=88

# ── Remote images ─────────────────────────────────────────────────────────────
# Covers are pre-fetched here rather than by the engine, because takumi's own
# fetch throws on failure and would kill the whole render.
IMAGE_FETCH_TIMEOUT_MS=3000
IMAGE_MAX_BYTES=8388608
