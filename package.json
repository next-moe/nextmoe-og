{
  "name": "nextmoe-og",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NextMoe unified Open Graph image renderer — takumi (Rust), no headless browser, cache-first.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "fonts": "tsx scripts/download-fonts.ts",
    "sign": "tsx scripts/sign-url.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.26",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "p-queue": "^9.3.0",
    "pino": "^10.3.1",
    "takumi-js": "^2.7.1",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
